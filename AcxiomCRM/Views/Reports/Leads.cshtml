@model IEnumerable<AcxiomCRM.Models.Entities.Lead>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">Lead Report</h1>
        <p class="text-muted small mb-0">Lead generation and conversion report</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Leads" asp-route-format="csv" class="btn btn-sm btn-outline-success">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Reports</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr><th>Code</th><th>Name</th><th>Email</th><th>Source</th><th>Status</th><th>Expected Value</th><th>Score</th><th>Priority</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td>@l.LeadCode</td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td>@l.Email</td>
                            <td>@l.Source</td>
                            <td>@l.Status</td>
                            <td>₹@l.ExpectedValue.ToString("N0")</td>
                            <td>@l.LeadScore</td>
                            <td>@l.Priority</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
