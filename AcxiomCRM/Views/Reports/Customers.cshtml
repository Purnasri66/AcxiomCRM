@model IEnumerable<AcxiomCRM.Models.Entities.Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">Customer Report</h1>
        <p class="text-muted small mb-0">Exportable customer directory</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Customers" asp-route-format="csv" class="btn btn-sm btn-outline-success">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Reports</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>City</th><th>Status</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CustomerCode</td>
                            <td class="fw-semibold">@c.CustomerName</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.City</td>
                            <td><span class="badge bg-@(c.Status == "Active" ? "success" : "secondary")">@c.Status</span></td>
                            <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
