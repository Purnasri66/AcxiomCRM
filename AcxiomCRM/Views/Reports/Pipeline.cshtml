@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Pipeline Report";
    var opps = ViewBag.Opportunities as IEnumerable<AcxiomCRM.Models.Entities.Opportunity> ?? Enumerable.Empty<AcxiomCRM.Models.Entities.Opportunity>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">Pipeline Stage Forecast</h1>
        <p class="text-muted small mb-0">Stage-wise summary and individual open deals</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" asp-route-format="csv" class="btn btn-sm btn-outline-success">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Reports</a>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase mb-1">@item.Stage</h6>
                    <div class="fs-4 fw-bold text-primary mb-1">₹@(((decimal)item.TotalValue).ToString("N0"))</div>
                    <div class="small text-muted">@item.Count deals • Weighted: <strong>₹@(((decimal)item.WeightedValue).ToString("N0"))</strong></div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-transparent border-bottom fw-semibold">Open Deals in Pipeline</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr><th>Deal Name</th><th>Amount</th><th>Stage</th><th>Probability</th><th>Expected Close</th></tr>
                </thead>
                <tbody>
                    @foreach (var o in opps)
                    {
                        <tr>
                            <td class="fw-semibold">@o.OpportunityName</td>
                            <td>₹@o.Amount.ToString("N0")</td>
                            <td><span class="badge bg-primary">@o.Stage</span></td>
                            <td>@o.Probability%</td>
                            <td>@(o.ExpectedCloseDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
