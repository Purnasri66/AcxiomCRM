@model AcxiomCRM.Models.ViewModels.LeadDetailsViewModel
@{
    ViewData["Title"] = $"Lead - {Model.Lead.LeadName}";
}

<!-- Lead Header Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="h4 fw-bold mb-0">@Model.Lead.LeadName</h2>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace">@Model.Lead.LeadCode</span>
                    <span class="badge bg-@(Model.Lead.Status switch { "Qualified" => "success", "Contacted" => "info", "Converted" => "primary", "Lost" => "danger", _ => "secondary" })">
                        @Model.Lead.Status
                    </span>
                </div>
                <div class="text-muted small">
                    @(Model.Lead.CompanyName ?? "No Company") • Source: <strong>@Model.Lead.Source</strong> • Created @Model.Lead.CreatedDate.ToString("MMM dd, yyyy")
                </div>
            </div>

            <!-- Workflow Status Actions & Conversion -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (Model.Lead.Status == "Qualified")
                {
                    <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-success btn-sm">
                        <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
                    </a>
                }

                @if (Model.ValidNextTransitions.Any())
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            Change Status
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li class="dropdown-header small">Valid Next States</li>
                            @foreach (var nextState in Model.ValidNextTransitions)
                            {
                                <li>
                                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@Model.Lead.LeadId" />
                                        <input type="hidden" name="newStatus" value="@nextState" />
                                        <button type="submit" class="dropdown-item small">
                                            Transition to <strong>@nextState</strong>
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <a asp-action="Edit" asp-route-id="@Model.Lead.LeadId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            </div>
        </div>

        <div class="row g-3 mt-3 pt-3 border-top small">
            <div class="col-md-3">
                <div class="text-muted">Expected Value</div>
                <div class="fw-bold fs-5 text-primary">₹@Model.Lead.ExpectedValue.ToString("N0")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Lead Score &amp; Priority</div>
                <div>
                    <span class="badge bg-@(Model.Lead.LeadScore >= 70 ? "success" : (Model.Lead.LeadScore >= 40 ? "warning" : "secondary")) fs-6">
                        @Model.Lead.LeadScore / 100
                    </span>
                    <span class="badge bg-secondary">@Model.Lead.Priority Priority</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Email</div>
                <div class="fw-semibold">@Model.Lead.Email</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Phone</div>
                <div class="fw-semibold">@Model.Lead.Phone</div>
            </div>
        </div>
    </div>
</div>

<!-- Related Follow-Ups and Activities -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-semibold mb-0"><i class="bi bi-calendar-check me-1"></i> Follow-Ups</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-sm btn-outline-primary">Schedule</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr><th>Date</th><th>Type</th><th>Remarks</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.RelatedFollowUps.Any())
                            {
                                @foreach (var fu in Model.RelatedFollowUps)
                                {
                                    <tr>
                                        <td>@fu.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@fu.FollowUpType</span></td>
                                        <td>@(fu.Remarks ?? "-")</td>
                                        <td><span class="badge bg-@(fu.Status == "Completed" ? "success" : (fu.Status == "Missed" ? "danger" : "warning"))">@fu.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No follow-ups for this lead.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-semibold mb-0"><i class="bi bi-list-check me-1"></i> Activities</h5>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-sm btn-outline-primary">Log Activity</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr><th>Type</th><th>Subject</th><th>Date</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.RelatedActivities.Any())
                            {
                                @foreach (var act in Model.RelatedActivities)
                                {
                                    <tr>
                                        <td><span class="badge bg-primary-subtle text-primary-emphasis">@act.ActivityType</span></td>
                                        <td class="fw-semibold">@act.Subject</td>
                                        <td>@act.ActivityDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-secondary">@act.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No activities logged for this lead.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
