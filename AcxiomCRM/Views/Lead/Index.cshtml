@model AcxiomCRM.Models.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Leads Management</h1>
        <p class="text-muted small mb-0">Track, score, qualify, and convert potential clients</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Lead
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, email, company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                    <option value="Contacted" selected="@(Model.StatusFilter == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(Model.StatusFilter == "Qualified")">Qualified</option>
                    <option value="Converted" selected="@(Model.StatusFilter == "Converted")">Converted</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                    <option value="Unqualified" selected="@(Model.StatusFilter == "Unqualified")">Unqualified</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="score">Sort by Lead Score</option>
                    <option value="date">Sort by Date Added</option>
                    <option value="name">Sort by Name</option>
                    <option value="value">Sort by Expected Value</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Leads Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Expected Value</th>
                        <th>Score &amp; Priority</th>
                        <th>Status</th>
                        <th>Assigned</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Leads.Any())
                    {
                        @foreach (var l in Model.Leads)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace">@l.LeadCode</span></td>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="text-decoration-none">
                                        @l.LeadName
                                    </a>
                                    <div class="small text-muted">@l.Email</div>
                                </td>
                                <td>@(l.CompanyName ?? "-")</td>
                                <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                                <td>₹@l.ExpectedValue.ToString("N0")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-@(l.LeadScore >= 70 ? "success" : (l.LeadScore >= 40 ? "warning" : "secondary"))">
                                            @l.LeadScore / 100
                                        </span>
                                        <span class="badge bg-outline-secondary small">@l.Priority</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-@(l.Status switch { "Qualified" => "success", "Contacted" => "info", "Converted" => "primary", "Lost" => "danger", _ => "secondary" })">
                                        @l.Status
                                    </span>
                                </td>
                                <td class="small text-muted">@l.AssignedUserName</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (l.Status == "Qualified")
                                        {
                                            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </a>
                                        }
                                        <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteLead-@l.LeadId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteLead-@l.LeadId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Delete Lead</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body text-start">
                                                    Are you sure you want to delete lead <strong>@l.LeadName</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger btn-sm">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted small">No leads found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total leads)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
