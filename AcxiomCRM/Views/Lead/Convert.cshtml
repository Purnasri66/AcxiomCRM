@model AcxiomCRM.Models.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent p-4 border-bottom">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-success-subtle text-success-emphasis p-2 rounded-circle"><i class="bi bi-arrow-repeat fs-5"></i></span>
                    <h4 class="fw-bold mb-0">Convert Qualified Lead</h4>
                </div>
                <p class="text-muted small mb-0">Convert lead into an active Customer with duplicate checking and optional Opportunity creation inside a single transaction.</p>
            </div>
            <div class="card-body p-4">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="p-3 rounded bg-body-tertiary mb-4">
                    <div class="fw-bold mb-2">Lead Information to be converted:</div>
                    <div class="row small g-2">
                        <div class="col-6"><span class="text-muted">Lead Name:</span> <strong>@Model.LeadName</strong></div>
                        <div class="col-6"><span class="text-muted">Code:</span> <strong>@Model.LeadCode</strong></div>
                        <div class="col-6"><span class="text-muted">Email:</span> <strong>@Model.Email</strong></div>
                        <div class="col-6"><span class="text-muted">Phone:</span> <strong>@Model.Phone</strong></div>
                        <div class="col-12"><span class="text-muted">Company:</span> <strong>@(Model.CompanyName ?? "-")</strong></div>
                    </div>
                </div>

                <form asp-action="Convert" method="post">
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="toggleOpp" />
                        <label class="form-check-label fw-semibold small" for="toggleOpp">Also create an initial Opportunity for this customer</label>
                    </div>

                    <div id="oppFields" class="row g-3 p-3 border rounded-3 mb-4 bg-body">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name</label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label small fw-semibold">Opportunity Amount (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Amount" class="form-control" type="number" step="1000" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Convert to Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleOpp').addEventListener('change', function () {
            document.getElementById('oppFields').style.display = this.checked ? 'flex' : 'none';
        });
    </script>
}
