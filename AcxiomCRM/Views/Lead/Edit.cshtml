@model AcxiomCRM.Models.ViewModels.LeadCreateEditViewModel
@{
    ViewData["Title"] = "Edit Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent p-4 border-bottom">
                <h4 class="fw-bold mb-1">Edit Lead</h4>
                <p class="text-muted small mb-0">Update lead information</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="LeadId" />
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label small fw-semibold">Lead Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label small fw-semibold">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label small fw-semibold">Lead Source <span class="text-danger">*</span></label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="LinkedIn">LinkedIn</option>
                                <option value="Partner">Partner</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Email Campaign">Email Campaign</option>
                                <option value="Trade Show">Trade Show</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label small fw-semibold">Expected Deal Value (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="1000" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Update Lead</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
