@model AcxiomCRM.Models.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">User Management</h1>
        <p class="text-muted small mb-0">Administer team accounts, roles, lockouts, and credentials</p>
    </div>
    <a asp-action="Permissions" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-key me-1"></i> View Permissions Matrix
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Account Status</th>
                        <th>Lockout</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td class="fw-semibold">@u.FullName</td>
                            <td>@u.Email</td>
                            <td>
                                <span class="badge bg-@(u.Role switch { "Admin" => "danger", "Manager" => "primary", _ => "info" })">
                                    @u.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@(u.IsActive ? "success" : "secondary")">
                                    @(u.IsActive ? "Active" : "Deactivated")
                                </span>
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Normal</span>
                                }
                            </td>
                            <td class="small text-muted">@(u.LastLoginDate?.ToString("MMM dd, yyyy") ?? "Never")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-warning" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    @if (u.IsLockedOut)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-success" title="Unlock Account">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-@(u.IsActive ? "danger" : "success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi bi-power"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
