@model AcxiomCRM.Models.ViewModels.AuditLogListViewModel
@{
    ViewData["Title"] = "Audit Logs & Diff Viewer";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">System Audit Logs</h1>
        <p class="text-muted small mb-0">Append-only compliance audit trail with field-by-field diff comparison</p>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="entityFilter" value="@Model.EntityFilter" class="form-control form-control-sm" placeholder="Filter by Entity (Customer, Lead, etc)" />
            </div>
            <div class="col-md-3">
                <input type="text" name="actionFilter" value="@Model.ActionFilter" class="form-control form-control-sm" placeholder="Filter by Action (Create, Update, etc)" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" placeholder="Start Date" />
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" placeholder="End Date" />
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>User ID</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>Field-by-Field Diff</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var log in Model.Items)
                        {
                            <tr>
                                <td class="small fw-semibold">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="small font-monospace text-truncate" style="max-width: 140px;" title="@log.UserId">@log.UserId</td>
                                <td>
                                    <span class="badge bg-@(log.Action switch { "Create" => "success", "Update" => "primary", "Delete" => "danger", "StatusChange" => "warning", "Convert" => "info", _ => "secondary" })">
                                        @log.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-dark-subtle text-dark-emphasis">@log.EntityName</span></td>
                                <td class="small font-monospace">@(log.RecordId ?? "-")</td>
                                <td>
                                    @if (log.DiffItems.Any())
                                    {
                                        <button class="btn btn-sm btn-outline-info py-0 px-2 small" type="button" data-bs-toggle="collapse" data-bs-target="#diff-@log.AuditLogId">
                                            <i class="bi bi-file-diff me-1"></i> View Diff (@log.DiffItems.Count fields)
                                        </button>
                                        <div class="collapse mt-2" id="diff-@log.AuditLogId">
                                            <div class="card card-body p-2 bg-body-tertiary border small">
                                                <table class="table table-sm table-bordered mb-0 bg-body">
                                                    <thead>
                                                        <tr>
                                                            <th>Field</th>
                                                            <th class="text-danger">Old Value</th>
                                                            <th class="text-success">New Value</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var diff in log.DiffItems)
                                                        {
                                                            <tr>
                                                                <td class="fw-semibold">@diff.FieldName</td>
                                                                <td class="text-danger font-monospace">@diff.OldValue</td>
                                                                <td class="text-success font-monospace">@diff.NewValue</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                    else if (!string.IsNullOrEmpty(log.NewValue))
                                    {
                                        <span class="small text-muted font-monospace text-truncate d-inline-block" style="max-width: 250px;" title="@log.NewValue">
                                            @log.NewValue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="small text-muted font-monospace">@(log.IpAddress ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted small">No audit logs found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount entries)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
