@model AcxiomCRM.Models.ViewModels.FollowUpCreateEditViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
    var customers = ViewBag.Customers as IEnumerable<AcxiomCRM.Models.Entities.Customer> ?? Enumerable.Empty<AcxiomCRM.Models.Entities.Customer>();
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent p-4 border-bottom">
                <h4 class="fw-bold mb-1">Schedule Follow-Up</h4>
                <p class="text-muted small mb-0">Set a reminder for calls, meetings, or emails with clients</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="OpportunityId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label small fw-semibold">Follow-Up Date <span class="text-danger">*</span></label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-ddT10:00")" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label small fw-semibold">Follow-Up Type <span class="text-danger">*</span></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Demo">Demo</option>
                                <option value="Visit">On-site Visit</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Related Customer</label>
                            <select asp-for="CustomerId" class="form-select">
                                <option value="">-- Optional / None --</option>
                                @foreach (var c in customers)
                                {
                                    <option value="@c.CustomerId" selected="@(c.CustomerId == Model.CustomerId)">@c.CustomerName (@c.CustomerCode)</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label small fw-semibold">Remarks &amp; Objective</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Discussion points, preparation notes..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-calendar-check me-1"></i> Schedule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
