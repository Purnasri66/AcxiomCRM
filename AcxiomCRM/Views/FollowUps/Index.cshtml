@model AcxiomCRM.Models.ViewModels.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Follow-Ups</h1>
        <p class="text-muted small mb-0">Schedule, complete, reschedule and manage customer follow-ups</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned (Pending)</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed / Overdue</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="date">Sort by Date</option>
                    <option value="type">Sort by Type</option>
                    <option value="status">Sort by Status</option>
                </select>
            </div>
            <div class="col-md-4 text-end">
                @if (!string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Follow-ups Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Type</th>
                        <th>Related Record</th>
                        <th>Remarks</th>
                        <th>Status</th>
                        <th>Assigned</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FollowUps.Any())
                    {
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr class="@(f.IsOverdue ? "table-danger-subtle" : "")">
                                <td>
                                    <div class="fw-semibold">@f.FollowUpDate.ToString("MMM dd, yyyy")</div>
                                    @if (f.IsOverdue)
                                    {
                                        <span class="badge bg-danger smaller"><i class="bi bi-exclamation-triangle"></i> Overdue</span>
                                    }
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@f.FollowUpType</span></td>
                                <td>
                                    @if (f.CustomerId.HasValue)
                                    {
                                        <div><i class="bi bi-people text-primary me-1"></i> <a asp-controller="Customer" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none">@f.CustomerName</a></div>
                                    }
                                    @if (f.LeadId.HasValue)
                                    {
                                        <div><i class="bi bi-funnel text-warning me-1"></i> <a asp-controller="Lead" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none">@f.LeadName</a></div>
                                    }
                                    @if (f.OpportunityId.HasValue)
                                    {
                                        <div><i class="bi bi-briefcase text-success me-1"></i> <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@f.OpportunityId" class="text-decoration-none">@f.OpportunityName</a></div>
                                    }
                                </td>
                                <td class="small">@(f.Remarks ?? "-")</td>
                                <td>
                                    <span class="badge bg-@(f.Status switch { "Completed" => "success", "Missed" => "danger", "Cancelled" => "secondary", _ => "warning" })">
                                        @f.Status
                                    </span>
                                </td>
                                <td class="small text-muted">@f.AssignedUserName</td>
                                <td class="text-end">
                                    @if (f.Status == "Planned")
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId" title="Complete">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.FollowUpId" title="Reschedule">
                                                <i class="bi bi-clock"></i>
                                            </button>
                                            <form asp-action="Cancel" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger" title="Cancel">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Complete Modal -->
                                        <div class="modal fade" id="completeModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <form asp-action="Complete" method="post">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Complete Follow-Up</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="id" value="@f.FollowUpId" />
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">Outcome / Completion Remarks</label>
                                                                <textarea name="remarks" class="form-control" rows="3" placeholder="Notes on outcome of follow-up..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                            <button type="submit" class="btn btn-success btn-sm">Mark as Completed</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Reschedule Modal -->
                                        <div class="modal fade" id="rescheduleModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <form asp-action="Reschedule" method="post">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Reschedule Follow-Up</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="id" value="@f.FollowUpId" />
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold">New Date &amp; Time <span class="text-danger">*</span></label>
                                                                <input type="datetime-local" name="newDate" class="form-control" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-ddTHH:mm")" required />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                            <button type="submit" class="btn btn-info btn-sm">Confirm Reschedule</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted small">No follow-ups recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
