@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <i class="bi bi-shield-lock-fill text-warning display-1 mb-3"></i>
                <h2 class="h4 mb-2">Access Denied</h2>
                <p class="text-muted mb-4">You do not have permission to access this resource or record. Contact your system administrator if you believe this is an error.</p>
                <div>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
