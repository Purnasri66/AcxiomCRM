@model AcxiomCRM.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In - AcxiomCRM";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-body-secondary d-flex align-items-center min-vh-100 py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3" style="width: 56px; height: 56px;">
                                <i class="bi bi-diagram-3-fill fs-3"></i>
                            </div>
                            <h3 class="fw-bold text-gradient mb-1">AcxiomCRM</h3>
                            <p class="text-muted small">Enterprise Customer Relationship Management</p>
                        </div>

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                        {
                            <div class="alert alert-danger py-2 small" role="alert">
                                @Html.ValidationSummary(true, "")
                            </div>
                        }

                        <form asp-action="Login" method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@acxiomcrm.com" autofocus />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                                    <label class="form-check-label small" asp-for="RememberMe">Remember me</label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 mb-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </button>

                            <div class="text-center small text-muted">
                                Don't have an account? <a asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
                            </div>
                        </form>

                        <div class="mt-4 pt-3 border-top text-center">
                            <span class="badge bg-secondary-subtle text-secondary-emphasis small p-2 w-100 text-start">
                                <strong>Demo Credentials:</strong><br/>
                                • Admin: admin@acxiomcrm.com / Admin@@12345<br/>
                                • Manager: manager@acxiomcrm.com / Manager@@12345<br/>
                                • Sales: sales1@acxiomcrm.com / Sales@@12345
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
