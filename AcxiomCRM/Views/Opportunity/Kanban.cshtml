@model AcxiomCRM.Models.ViewModels.KanbanBoardViewModel
@{
    ViewData["Title"] = "Kanban Pipeline Board";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Pipeline Kanban Board</h1>
        <p class="text-muted small mb-0">Drag and drop opportunities across pipeline stages</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul me-1"></i> List View
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Opportunity
        </a>
    </div>
</div>

<div class="kanban-board">
    @{
        var stages = new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" };
    }
    @foreach (var stage in stages)
    {
        var deals = Model.Stages.ContainsKey(stage) ? Model.Stages[stage] : new List<AcxiomCRM.Models.ViewModels.OpportunityItemViewModel>();
        var totalAmount = deals.Sum(d => d.Amount);

        <div class="kanban-column" data-stage="@stage">
            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                <div>
                    <span class="fw-bold fs-6">@stage</span>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill ms-1">@deals.Count</span>
                </div>
                <div class="text-muted small fw-semibold">₹@totalAmount.ToString("N0")</div>
            </div>

            <div class="kanban-cards" ondragover="event.preventDefault()" ondrop="dropDeal(event, '@stage')">
                @foreach (var deal in deals)
                {
                    <div class="kanban-card" draggable="true" ondragstart="dragDeal(event, @deal.OpportunityId)" id="deal-@deal.OpportunityId">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <a asp-action="Details" asp-route-id="@deal.OpportunityId" class="text-decoration-none fw-semibold small text-truncate" style="max-width: 180px;">
                                @deal.OpportunityName
                            </a>
                            <span class="badge bg-@deal.DealHealthColor smaller" title="Health Score">@deal.DealHealthScore</span>
                        </div>
                        <div class="small text-muted mb-2 text-truncate">@deal.CustomerName</div>
                        <div class="d-flex justify-content-between align-items-center small">
                            <span class="fw-bold text-primary">₹@deal.Amount.ToString("N0")</span>
                            <span class="badge bg-light text-dark border smaller">@deal.Probability%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    let draggedDealId = null;

    function dragDeal(ev, dealId) {
        draggedDealId = dealId;
        ev.target.classList.add('dragging');
        ev.dataTransfer.setData("text/plain", dealId);
    }

    document.addEventListener("dragend", function(e) {
        if (e.target.classList) {
            e.target.classList.remove('dragging');
        }
    });

    function dropDeal(ev, newStage) {
        ev.preventDefault();
        const dealId = draggedDealId;
        if (!dealId) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        fetch('/Opportunity/UpdateStage', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token || ''
            },
            body: JSON.stringify({
                opportunityId: dealId,
                newStage: newStage
            })
        })
        .then(response => {
            if (response.ok) {
                window.location.reload();
            } else {
                return response.json().then(err => {
                    alert(err.message || 'Failed to update deal stage.');
                });
            }
        })
        .catch(err => {
            alert('Error updating stage: ' + err);
        });
    }
</script>
}
