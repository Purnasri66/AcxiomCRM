@model AcxiomCRM.Models.ViewModels.OpportunityCreateEditViewModel
@{
    ViewData["Title"] = "Edit Opportunity";
    var customers = ViewBag.Customers as IEnumerable<AcxiomCRM.Models.Entities.Customer> ?? Enumerable.Empty<AcxiomCRM.Models.Entities.Customer>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent p-4 border-bottom">
                <h4 class="fw-bold mb-1">Edit Opportunity</h4>
                <p class="text-muted small mb-0">Update deal information and stage</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="OpportunityId" />
                    <input type="hidden" asp-for="LeadId" />
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Customer <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" class="form-select">
                                @foreach (var c in customers)
                                {
                                    <option value="@c.CustomerId" selected="@(c.CustomerId == Model.CustomerId)">@c.CustomerName (@c.CustomerCode)</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label small fw-semibold">Deal Amount (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Amount" class="form-control" type="number" step="1000" min="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label small fw-semibold">Pipeline Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label small fw-semibold">Probability (%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date</label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Open">Open</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Update Opportunity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
