@model AcxiomCRM.Models.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = $"Opportunity - {Model.Opportunity.OpportunityName}";
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="h4 fw-bold mb-0">@Model.Opportunity.OpportunityName</h2>
                    <span class="badge bg-primary">@Model.Opportunity.Stage</span>
                    <span class="badge bg-@(Model.Opportunity.Status == "Won" ? "success" : (Model.Opportunity.Status == "Lost" ? "danger" : "secondary"))">
                        @Model.Opportunity.Status
                    </span>
                </div>
                <div class="text-muted small">
                    Customer: <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.Opportunity.CustomerId" class="fw-semibold text-decoration-none">@Model.Opportunity.Customer?.CustomerName</a> •
                    Created @Model.Opportunity.CreatedDate.ToString("MMM dd, yyyy")
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
                </a>
            </div>
        </div>

        <div class="row g-3 mt-3 pt-3 border-top">
            <div class="col-md-3">
                <div class="text-muted small">Amount</div>
                <div class="fw-bold fs-4 text-primary">₹@Model.Opportunity.Amount.ToString("N0")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Probability &amp; Weighted Value</div>
                <div class="fw-bold fs-5">@Model.Opportunity.Probability% <span class="text-muted fs-6">(₹@Model.Opportunity.WeightedValue.ToString("N0"))</span></div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Deal Health Score</div>
                <div>
                    <span class="badge bg-@Model.DealHealthColor fs-6 p-2" title="Computed from probability, days to close, activity frequency and overdue followups">
                        <i class="bi bi-heart-pulse me-1"></i> @Model.DealHealthScore / 100 (@Model.DealHealthLabel)
                    </span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Expected Close Date</div>
                <div class="fw-semibold">@(Model.Opportunity.ExpectedCloseDate?.ToString("MMMM dd, yyyy") ?? "Not set")</div>
            </div>
        </div>
    </div>
</div>

<!-- Follow-ups & Activities for Opportunity -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-semibold mb-0"><i class="bi bi-calendar-check me-1"></i> Opportunity Follow-Ups</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-sm btn-outline-primary">Schedule</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr><th>Date</th><th>Type</th><th>Remarks</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.RelatedFollowUps.Any())
                            {
                                @foreach (var fu in Model.RelatedFollowUps)
                                {
                                    <tr>
                                        <td>@fu.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@fu.FollowUpType</span></td>
                                        <td>@(fu.Remarks ?? "-")</td>
                                        <td><span class="badge bg-@(fu.Status == "Completed" ? "success" : (fu.Status == "Missed" ? "danger" : "warning"))">@fu.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No follow-ups recorded.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-semibold mb-0"><i class="bi bi-list-check me-1"></i> Activities</h5>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Opportunity.CustomerId" class="btn btn-sm btn-outline-primary">Log Activity</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr><th>Type</th><th>Subject</th><th>Date</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.RelatedActivities.Any())
                            {
                                @foreach (var act in Model.RelatedActivities)
                                {
                                    <tr>
                                        <td><span class="badge bg-primary-subtle text-primary-emphasis">@act.ActivityType</span></td>
                                        <td class="fw-semibold">@act.Subject</td>
                                        <td>@act.ActivityDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-secondary">@act.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No activities linked.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
