@model AcxiomCRM.Models.ViewModels.OpportunityListViewModel
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Opportunities Pipeline</h1>
        <p class="text-muted small mb-0">Manage deals, probability, deal health scores, and forecast</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Kanban" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-kanban me-1"></i> Kanban View
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Opportunity
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by opportunity or customer..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="stageFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="date">Sort by Date</option>
                    <option value="amount">Sort by Amount</option>
                    <option value="name">Sort by Name</option>
                    <option value="close">Sort by Close Date</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.StageFilter))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Opportunity</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Deal Health</th>
                        <th>Expected Close</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Opportunities.Any())
                    {
                        @foreach (var o in Model.Opportunities)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                        @o.OpportunityName
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@o.CustomerId" class="text-decoration-none small">
                                        @o.CustomerName
                                    </a>
                                </td>
                                <td class="fw-bold">₹@o.Amount.ToString("N0")</td>
                                <td><span class="badge bg-primary">@o.Stage</span></td>
                                <td>@o.Probability%</td>
                                <td class="text-muted">₹@o.WeightedValue.ToString("N0")</td>
                                <td>
                                    <span class="badge bg-@o.DealHealthColor"
                                          data-bs-toggle="tooltip"
                                          data-bs-placement="top"
                                          title="Deal Health Score: @o.DealHealthScore/100 (@o.DealHealthLabel). Evaluates probability, days to expected close, activity frequency and overdue follow-ups.">
                                        <i class="bi bi-heart-pulse me-1"></i> @o.DealHealthScore (@o.DealHealthLabel)
                                    </span>
                                </td>
                                <td class="small">@(o.ExpectedCloseDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteOpp-@o.OpportunityId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteOpp-@o.OpportunityId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Delete Opportunity</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body text-start">
                                                    Are you sure you want to delete opportunity <strong>@o.OpportunityName</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger btn-sm">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted small">No opportunities found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-stageFilter="@Model.StageFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-stageFilter="@Model.StageFilter">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-stageFilter="@Model.StageFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>

@section Scripts {
<script>
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
</script>
}
