@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4">
                <i class="bi bi-exclamation-triangle-fill text-danger display-1 mb-3"></i>
                <h2 class="h4 mb-2">Something went wrong</h2>
                <p class="text-muted mb-4">An error occurred while processing your request. Please try again later or contact your administrator.</p>
                <div>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house-door me-1"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
