@model AcxiomCRM.Models.ViewModels.ActivityListViewModel
@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Activity History</h1>
        <p class="text-muted small mb-0">Log of customer interactions: Calls, Meetings, Emails, and Tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i> Log Activity
    </a>
</div>

<!-- Type Filter -->
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="typeFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Calls</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meetings</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Emails</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Tasks</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="date">Sort by Date</option>
                    <option value="type">Sort by Type</option>
                    <option value="subject">Sort by Subject</option>
                </select>
            </div>
            <div class="col-md-4 text-end">
                @if (!string.IsNullOrEmpty(Model.TypeFilter))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Activities Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Related Entity</th>
                        <th>Status</th>
                        <th>Assigned</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Activities.Any())
                    {
                        @foreach (var a in Model.Activities)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary-emphasis">
                                        <i class="bi @(a.ActivityType switch { "Call" => "bi-telephone", "Meeting" => "bi-people", "Email" => "bi-envelope", _ => "bi-check2-square" }) me-1"></i>
                                        @a.ActivityType
                                    </span>
                                </td>
                                <td class="fw-semibold">@a.Subject</td>
                                <td class="small text-muted text-truncate" style="max-width: 250px;">@(a.Description ?? "-")</td>
                                <td class="small">@a.ActivityDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (a.CustomerId.HasValue)
                                    {
                                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@a.CustomerId" class="text-decoration-none small">
                                            <i class="bi bi-people text-primary me-1"></i> @a.CustomerName
                                        </a>
                                    }
                                    @if (a.LeadId.HasValue)
                                    {
                                        <a asp-controller="Lead" asp-action="Details" asp-route-id="@a.LeadId" class="text-decoration-none small">
                                            <i class="bi bi-funnel text-warning me-1"></i> @a.LeadName
                                        </a>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@a.Status</span></td>
                                <td class="small text-muted">@a.AssignedUserName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted small">No activities recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
