@model AcxiomCRM.Models.ViewModels.ActivityCreateEditViewModel
@{
    ViewData["Title"] = "Log Activity";
    var customers = ViewBag.Customers as IEnumerable<AcxiomCRM.Models.Entities.Customer> ?? Enumerable.Empty<AcxiomCRM.Models.Entities.Customer>();
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent p-4 border-bottom">
                <h4 class="fw-bold mb-1">Log Customer Activity</h4>
                <p class="text-muted small mb-0">Record a Call, Meeting, Email, or Task interaction</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                    <input type="hidden" asp-for="LeadId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label small fw-semibold">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label small fw-semibold">Activity Date <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label small fw-semibold">Subject / Title <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Quarterly review call with VP of Tech" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Related Customer</label>
                            <select asp-for="CustomerId" class="form-select">
                                <option value="">-- Optional / None --</option>
                                @foreach (var c in customers)
                                {
                                    <option value="@c.CustomerId" selected="@(c.CustomerId == Model.CustomerId)">@c.CustomerName (@c.CustomerCode)</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-semibold">Description &amp; Key Discussion Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Summary of outcomes and next steps..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
