@model AcxiomCRM.Models.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = $"Customer 360 - {Model.Customer.CustomerName}";
}

<!-- Customer 360 Header -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fs-2" style="width: 64px; height: 64px;">
                    @Model.Customer.CustomerName.Substring(0, 1).ToUpper()
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="h4 fw-bold mb-0">@Model.Customer.CustomerName</h2>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace">@Model.Customer.CustomerCode</span>
                        <span class="badge bg-@(Model.Customer.Status == "Active" ? "success" : "secondary")">@Model.Customer.Status</span>
                    </div>
                    <div class="text-muted small">
                        @(Model.Customer.CompanyName ?? "No Company") • Created on @Model.Customer.CreatedDate.ToString("MMM dd, yyyy")
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-briefcase me-1"></i> New Opportunity
                </a>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
                </a>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i> Log Activity
                </a>
            </div>
        </div>

        <div class="row g-3 mt-3 pt-3 border-top small">
            <div class="col-md-3">
                <div class="text-muted">Email</div>
                <div class="fw-semibold"><a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a></div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Phone</div>
                <div class="fw-semibold">@Model.Customer.Phone</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Address</div>
                <div class="fw-semibold">@(Model.Customer.Address ?? "-")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted">Location</div>
                <div class="fw-semibold">@Model.Customer.City @(!string.IsNullOrEmpty(Model.Customer.State) ? $", {Model.Customer.State}" : "-")</div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs for 360 View: Unified Timeline, Opportunities, Leads, Follow-ups, Activities, Audit -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-transparent border-bottom px-4 pt-3 pb-0">
        <ul class="nav nav-tabs card-header-tabs" id="customer360Tabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-semibold" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#timeline" type="button">
                    <i class="bi bi-clock-history me-1"></i> Chronological Timeline (@Model.UnifiedTimeline.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="opportunities-tab" data-bs-toggle="tab" data-bs-target="#opportunities" type="button">
                    <i class="bi bi-briefcase me-1"></i> Opportunities (@Model.RelatedOpportunities.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button">
                    <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.RelatedFollowUps.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button">
                    <i class="bi bi-list-check me-1"></i> Activities (@Model.RelatedActivities.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="leads-tab" data-bs-toggle="tab" data-bs-target="#leads" type="button">
                    <i class="bi bi-funnel me-1"></i> Source Leads (@Model.RelatedLeads.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4 tab-content">
        <!-- 1. Chronological Unified Timeline -->
        <div class="tab-pane fade show active" id="timeline">
            <h5 class="fw-bold mb-4">Unified Activity, Follow-up & Audit Timeline</h5>
            @if (Model.UnifiedTimeline.Any())
            {
                <div class="timeline">
                    @foreach (var item in Model.UnifiedTimeline)
                    {
                        <div class="timeline-item">
                            <div class="timeline-icon">
                                <i class="bi @item.Icon text-@item.BadgeClass"></i>
                            </div>
                            <div class="card border-0 shadow-xs bg-body-tertiary rounded-3 p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-@item.BadgeClass-subtle text-@item.BadgeClass-emphasis">@item.ItemType</span>
                                    <span class="small text-muted">@item.Date.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <h6 class="fw-semibold mb-1">@item.Title</h6>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="text-muted small mb-0">@item.Description</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted small">No timeline events recorded yet.</div>
            }
        </div>

        <!-- 2. Related Opportunities -->
        <div class="tab-pane fade" id="opportunities">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Opportunities</h5>
                <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add Opportunity
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Opportunity Name</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Expected Close</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RelatedOpportunities.Any())
                        {
                            @foreach (var opp in Model.RelatedOpportunities)
                            {
                                <tr>
                                    <td class="fw-semibold"><a asp-controller="Opportunity" asp-action="Details" asp-route-id="@opp.OpportunityId">@opp.OpportunityName</a></td>
                                    <td>₹@opp.Amount.ToString("N0")</td>
                                    <td><span class="badge bg-primary">@opp.Stage</span></td>
                                    <td>@opp.Probability%</td>
                                    <td>@(opp.ExpectedCloseDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                    <td><span class="badge bg-@(opp.Status == "Won" ? "success" : (opp.Status == "Lost" ? "danger" : "secondary"))">@opp.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted small">No opportunities linked.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 3. Related Follow-ups -->
        <div class="tab-pane fade" id="followups">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Follow-Ups</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-primary">
                    <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-up
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Remarks</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RelatedFollowUps.Any())
                        {
                            @foreach (var fu in Model.RelatedFollowUps)
                            {
                                <tr>
                                    <td>@fu.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@fu.FollowUpType</span></td>
                                    <td>@(fu.Remarks ?? "-")</td>
                                    <td><span class="badge bg-@(fu.Status == "Completed" ? "success" : (fu.Status == "Missed" ? "danger" : "warning"))">@fu.Status</span></td>
                                    <td>@fu.AssignedTo</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted small">No follow-ups recorded.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 4. Related Activities -->
        <div class="tab-pane fade" id="activities">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Activities</h5>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Log Activity
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RelatedActivities.Any())
                        {
                            @foreach (var act in Model.RelatedActivities)
                            {
                                <tr>
                                    <td><span class="badge bg-primary-subtle text-primary-emphasis">@act.ActivityType</span></td>
                                    <td class="fw-semibold">@act.Subject</td>
                                    <td>@act.ActivityDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-secondary">@act.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted small">No activities recorded.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 5. Source Leads -->
        <div class="tab-pane fade" id="leads">
            <h5 class="fw-bold mb-3">Source Leads</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Lead Code</th>
                            <th>Lead Name</th>
                            <th>Source</th>
                            <th>Expected Value</th>
                            <th>Score</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RelatedLeads.Any())
                        {
                            @foreach (var lead in Model.RelatedLeads)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace">@lead.LeadCode</span></td>
                                    <td class="fw-semibold"><a asp-controller="Lead" asp-action="Details" asp-route-id="@lead.LeadId">@lead.LeadName</a></td>
                                    <td>@lead.Source</td>
                                    <td>₹@lead.ExpectedValue.ToString("N0")</td>
                                    <td><span class="badge bg-info">@lead.LeadScore</span></td>
                                    <td><span class="badge bg-success">@lead.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted small">No related leads.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
