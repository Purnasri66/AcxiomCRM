@model AcxiomCRM.Models.ViewModels.CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Customers</h1>
        <p class="text-muted small mb-0">Manage customer accounts and Customer 360 profiles</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Customer
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, email, phone, company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="date">Sort by Date Added</option>
                    <option value="name">Sort by Name</option>
                    <option value="email">Sort by Email</option>
                    <option value="company">Sort by Company</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-secondary w-100">Filter</button>
            </div>
            <div class="col-md-2 text-end">
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Customers Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>City / State</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Customers.Any())
                    {
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace">@c.CustomerCode</span></td>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="text-decoration-none">
                                        @c.CustomerName
                                    </a>
                                </td>
                                <td>@c.Email</td>
                                <td>@c.Phone</td>
                                <td>@(c.CompanyName ?? "-")</td>
                                <td>@c.City @(!string.IsNullOrEmpty(c.State) ? $", {c.State}" : "")</td>
                                <td>
                                    <span class="badge bg-@(c.Status == "Active" ? "success" : "secondary")">@c.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="Customer 360 View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@c.CustomerId" title="Deactivate">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteModal-@c.CustomerId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Confirm Deactivation</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-start">
                                                    Are you sure you want to deactivate customer <strong>@c.CustomerName</strong> (@c.CustomerCode)?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger btn-sm">Confirm Deactivate</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted small">No customers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
